# Edit only the gitignored local .env; never paste credentials in chat or shell history.
TIMETREE_EMAIL=
TIMETREE_PASSWORD=
# Google/Apple sign-in: use only the local _session_id cookie value, never paste it in chat.
# A supplied session takes precedence over email/password. Refresh it locally when expired.
TIMETREE_SESSION_COOKIE=
# Run list_calendars first, identify 共用行事曆, then pin its numeric ID and restart MCP.
# Calendar names are not unique. Leave blank until the ID has been confirmed.
TIMETREE_CALENDAR_ID=
LOG_LEVEL=INFO
