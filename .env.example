# Copy this file to .env and fill in real values.
# Recommended: use a dedicated TimeTree account (not your main one) and invite it
# to the shared calendar you want this MCP to manage. If TimeTree ever flags the
# account for automated access, only the dedicated account is at risk.

TIMETREE_EMAIL=
TIMETREE_PASSWORD=

# Comma-separated list of TimeTree public calendar alias codes to expose via
# list_calendars when no args are passed. Each alias is the short code in the
# public URL, e.g. for https://timetr.ee/p/tjmdaan01 the code is tjmdaan01.
TIMETREE_CALENDAR_ALIASES=

# Log verbosity: DEBUG / INFO / WARN / ERROR (default INFO)
LOG_LEVEL=INFO
